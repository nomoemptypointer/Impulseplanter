<Window x:Class="Impulseplanter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impulseplanter"
        Height="450" Width="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#3F000000"
        AllowsTransparency="True">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>

                            <!-- Click -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selected text -->
                                    <ContentPresenter Margin="6,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"/>

                                    <!-- Arrow -->
                                    <Border Grid.Column="1"
                                    Background="Transparent">
                                        <TextBlock Text="▼"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="10"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Dropdown -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False">

                                <Border Background="#DD000000"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,2,0,0">

                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>

                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>

                            <!-- Open -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                  Margin="0"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33000000"/>
                            </Trigger>

                            <!-- Focus -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Background" Value="#44000000"/>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <!-- Box -->
                            <Border x:Name="Box"
                            Width="18"
                            Height="18"
                            CornerRadius="4"
                            Background="#22000000"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                              Data="M 0 5 L 4 9 L 12 1"
                              Stroke="White"
                              StrokeThickness="2"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                            </Border>

                            <!-- Label -->
                            <ContentPresenter Content="{TemplateBinding Content}"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <!-- Checked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#33000000"/>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
   
    <Border BorderBrush="#AAFFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            Padding="1"
            Opacity="0.9">

        <Grid Background="#22000000" Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0" Height="32">
                <TextBlock Text="Impulseplanter (Beta)"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"/>

                <Button Content="✕"
                        x:Name="CloseButton"
                        Width="32" Height="24"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>

            <!-- MAIN -->
            <Grid Grid.Row="1" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">

                    <!-- IMAGE -->
                    <Border Background="#33000000" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Image"
                                       x:Name="SelectImageButtonText"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,6"/>
                            <Button Content="Select Image"
                                    x:Name="SelectImageButton"
                                    Height="32"
                                    Background="#22000000"
                                    Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- AUDIO -->
                    <Border Background="#33000000" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Audio"
                                       x:Name="SelectAudioButtonText"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,6"/>
                            <Button Content="Select Audio"
                                    x:Name="SelectAudioButton"
                                    Height="32"
                                    Background="#22000000"
                                    Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- SETTINGS -->
                    <Border Background="#33000000" CornerRadius="4" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Resolution"
                               Foreground="#CCCCCC"
                               Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal">

                                <!-- WIDTH -->
                                <TextBox x:Name="WidthBox"
                                     Width="80"
                                     Text="1920"
                                     HorizontalContentAlignment="Center"
                                     Margin="0,0,5,0"/>

                                <TextBlock Text="×"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   Margin="0,0,5,0"/>

                                <!-- HEIGHT -->
                                <TextBox x:Name="HeightBox"
                                     Width="80"
                                     Text="1080"
                                     HorizontalContentAlignment="Center"/>

                            </StackPanel>

                            <CheckBox x:Name="StretchCheckBox"
                              Content="Stretch Image"
                              Foreground="White"
                              Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- PREVIEW -->
                <Border Grid.Column="1"
                    Background="#22000000"
                    CornerRadius="4"
                    Padding="10">
                    <Grid>
                        <Image x:Name="PreviewImage"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           ClipToBounds="True"/>
                    </Grid>
                </Border>

            </Grid>

            <!-- BOTTOM -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Height="6"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>

                <Button Grid.Column="1"
                        Content="Generate Video"
                        x:Name="GenerateButton"
                        Width="160"
                        Height="36"
                        Background="#55FFFFFF"
                        Foreground="Black"/>
            </Grid>

        </Grid>

    </Border>
</Window>